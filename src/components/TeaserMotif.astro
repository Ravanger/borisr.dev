---
/**
 * Per-section mark for the home teaser cards (Workbench): one small
 * mono-stroke glyph per section — brush for Art, waveform for Music,
 * node schematic for Projects, terminal prompt for Tools. All in the
 * theme accent; the mark is presentation, the `motif` key is data
 * (see teasers in src/data/site.ts).
 */
interface Props {
  motif: "brush" | "wave" | "nodes" | "terminal";
}

const { motif } = Astro.props;
---

<span class="teaser-mark" aria-hidden="true">
  {
    motif === "brush" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20 L12 12" />
        <path d="M12 12 L20 4 L21 5 L13 13 Z" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    motif === "wave" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 10v4" />
        <path d="M8 7v10" />
        <path d="M12 4v16" />
        <path d="M16 8v8" />
        <path d="M20 11v2" />
      </svg>
    )
  }
  {
    motif === "nodes" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M6 6h12" />
        <path d="M6 6l6 12" />
        <path d="M18 6l-6 12" />
        <circle cx="6" cy="6" r="2.5" fill="currentColor" stroke="none" />
        <circle cx="18" cy="6" r="2.5" fill="currentColor" stroke="none" />
        <circle cx="12" cy="18" r="2.5" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    motif === "terminal" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="16" rx="1.5" />
        <path d="M7 9l3 3-3 3" />
        <path d="M12 15h5" />
      </svg>
    )
  }
</span>
