---
import InstagramFeed from "../components/InstagramFeed.svelte";
import { art, sections } from "../data/site";
---

<section id="art" class="section">
  <p class="eyebrow">{sections.art.eyebrow}</p>
  <h2 class="section-title">{sections.art.title}</h2>
  <p class="muted mt-3 max-w-xl text-sm leading-relaxed">{art.feedLine}</p>
  <div class="mt-6">
    <InstagramFeed client:load placeholderCount={art.tileCount} />
  </div>
  <p class="mt-5 text-sm">
    <a class="link-accent" href={art.instagramUrl} target="_blank" rel="noopener">{art.instagramLabel}</a>
    <span class="muted"> · </span>
    <a class="link-accent" href={art.tiktokUrl} target="_blank" rel="noopener">{art.tiktokLabel}</a>
  </p>
</section>
