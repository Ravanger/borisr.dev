---
import { music, sections } from "../data/site";

const { album } = music;
---

<section class="section" aria-labelledby="album-title">
  <p class="eyebrow">{sections.music.eyebrow}</p>
  <div class="album-hero mt-6">
    <figure class="min-w-0">
      <div class="album-art">
        <img
          src={album.artUrl}
          alt="From the Depths album art"
          width="1000"
          height="1000"
        />
      </div>
    </figure>
    <div class="min-w-0">
      <p class="album-label">{album.artist}</p>
      <h1 class="album-title" id="album-title">{album.title}</h1>
      <p class="album-meta">
        {album.tracks.length} TRACKS · {album.totalTime} · {album.year}
      </p>
      <ol class="tracklist">
        {
          album.tracks.map((track, i) => (
            <li>
              <a class="track-row" href={track.url} target="_blank" rel="noopener">
                <span class="track-num">{String(i + 1).padStart(2, "0")}</span>
                <span class="track-play" aria-hidden="true">▶</span>
                <span class="track-name">{track.name}</span>
                <span class="track-duration">{track.duration}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="album-actions">
        <a class="btn-solid" href={music.bandcampAlbumUrl} target="_blank" rel="noopener">{album.buyLabel} ↗</a>
        <a class="btn-outline" href={music.bandcampAlbumUrl} target="_blank" rel="noopener">{album.downloadLabel}</a>
      </div>
    </div>
  </div>
</section>
