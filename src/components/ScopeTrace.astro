---
/**
 * Oscilloscope hero trace (#22): a full-bleed 1px phosphor line on a
 * <canvas> behind the hero copy. Idle: slow sine. Cursor speed drives
 * amplitude/frequency and morphs the wave square-ish, like distortion
 * kicking in. prefers-reduced-motion: one static line, no animation.
 * DEVOUR MODE (Konami, see FunLayer.astro): the trace goes full fuzz
 * while <html> carries .devour-mode. The colour is read from the
 * --accent token, so the trace follows the theme (and the DEVOUR MODE
 * flip to LED red) on its own.
 */
---

<canvas class="scope-trace" aria-hidden="true"></canvas>

<script>
  // Re-run safe: view-transition navigation back to Home re-executes
  // this script with a fresh canvas, so stop the previous loop and
  // drop the previous listeners first.
  const prev = window.__scopeTrace;
  if (prev) {
    cancelAnimationFrame(prev.raf);
    window.removeEventListener("pointermove", prev.onMove);
    prev.resizeObserver.disconnect();
    prev.classObserver.disconnect();
  }

  const canvas = document.querySelector("canvas.scope-trace");
  const ctx = canvas.getContext("2d");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let w = 0;
  let h = 0;
  let color = getComputedStyle(document.documentElement).getPropertyValue("--accent").trim();

  // The trace colour follows the theme / DEVOUR MODE flip.
  const classObserver = new MutationObserver(() => {
    color = getComputedStyle(document.documentElement).getPropertyValue("--accent").trim();
  });
  classObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const rect = canvas.getBoundingClientRect();
    w = rect.width;
    h = rect.height;
    canvas.width = Math.max(1, Math.round(w * dpr));
    canvas.height = Math.max(1, Math.round(h * dpr));
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  // drive 0 = clean sine, 1 = full square-ish fuzz.
  function draw(phase, drive) {
    ctx.clearRect(0, 0, w, h);
    if (w === 0 || h === 0) return;
    const mid = h / 2;
    const amp = h * (0.16 + 0.26 * drive);
    const cycles = 1.5 + 2.5 * drive;
    const squash = Math.tanh(3);
    ctx.beginPath();
    for (let x = 0; x <= w; x += 2) {
      const s = Math.sin((x / w) * cycles * Math.PI * 2 + phase);
      const shaped = Math.tanh(3 * s) / squash;
      const y = mid - (s * (1 - drive) + shaped * drive) * amp;
      if (x === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  const resizeObserver = new ResizeObserver(() => {
    resize();
    if (reduced) draw(0, 0);
  });
  resizeObserver.observe(canvas);
  resize();

  if (reduced) {
    // Static line: no animation, no pointer tracking.
    draw(0, 0);
    window.__scopeTrace = { raf: 0, onMove: () => {}, resizeObserver, classObserver };
  } else {
    let phase = 0;
    let drive = 0;
    let speed = 0;
    let lastX = 0;
    let lastY = 0;
    let lastT = 0;

    function onMove(ev) {
      const now = performance.now();
      if (lastT > 0) {
        const dt = Math.max(1, now - lastT);
        const dist = Math.hypot(ev.clientX - lastX, ev.clientY - lastY);
        const inst = (dist / dt) * 1000;
        speed = speed * 0.8 + inst * 0.2;
      }
      lastX = ev.clientX;
      lastY = ev.clientY;
      lastT = now;
    }
    window.addEventListener("pointermove", onMove, { passive: true });

    let lastFrame = performance.now();
    let raf = 0;
    function frame(now) {
      const dt = Math.min(0.05, (now - lastFrame) / 1000);
      lastFrame = now;
      speed *= 0.92;
      const devour = document.documentElement.classList.contains("devour-mode");
      const target = devour ? 1 : Math.min(1, speed / 1200);
      drive += (target - drive) * 0.06;
      phase += dt * (1.2 + 5 * drive);
      draw(phase, drive);
      raf = requestAnimationFrame(frame);
    }
    raf = requestAnimationFrame(frame);
    window.__scopeTrace = { raf, onMove, resizeObserver, classObserver };
  }
</script>
