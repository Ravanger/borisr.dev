---
/**
 * Footer social icons: one inline-SVG set, 24px grid, 2px stroke,
 * stroke currentColor, turns phosphor on hover (see .social-link in
 * tokens.css). No icon files are committed — no hand-drawn icons
 * exist yet, and these are not faked as hand-drawn. Brand marks
 * are simplified stroke approximations, labelled by tooltip.
 */
interface Props {
  name: "github" | "instagram" | "tiktok" | "bandcamp" | "soundcloud" | "newgrounds";
}

const { name } = Astro.props;
---

{
  name === "github" && (
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
    </svg>
  )
}
{
  name === "instagram" && (
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
    </svg>
  )
}
{
  name === "tiktok" && (
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 3v10.8a3.7 3.7 0 1 1-3.7-3.7" />
      <path d="M15 3c.5 2.9 2.4 4.8 5.2 5.2" />
    </svg>
  )
}
{
  name === "bandcamp" && (
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 8h5l-4 8H1l4-8z" />
      <path d="M14 8l7 4-7 4V8z" />
    </svg>
  )
}
{
  name === "soundcloud" && (
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 15v3M5.5 13v6" />
      <path d="M9.5 19h8a3.5 3.5 0 0 0 .8-6.9 5 5 0 0 0-9.6-1.3A3.25 3.25 0 0 0 9.5 19z" />
    </svg>
  )
}
{
  name === "newgrounds" && (
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="2" y="13" width="13" height="6" rx="3" />
      <path d="M15 16h7" />
      <path d="M6 13V9.5h5V13" />
    </svg>
  )
}
