---
import type { CollectionEntry } from "astro:content";
import { projectsMoreLine, sections } from "../data/site";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section id="projects" class="section">
  <p class="eyebrow">{sections.projects.eyebrow}</p>
  <h2 class="section-title">{sections.projects.title}</h2>
  {
    projects.map((entry) => {
      const p = entry.data;
      const href = `/projects/${entry.id}`;
      return (
        <article class="card node-row mt-6 p-6">
          <span class="node-disc" aria-hidden="true">&nearr;</span>
          <span class="node-link" aria-hidden="true"></span>
          <div class="node-body">
            <a href={href} aria-label={p.title}>
              <img
                src={p.thumb}
                alt=""
                loading="lazy"
                width="1200"
                height="600"
                class="project-thumb"
              />
            </a>
            <h3 class="font-display text-xl font-semibold">
              <a href={href} class="hover:underline">
                {p.title}
              </a>
            </h3>
            <p class="muted mt-2 text-sm leading-relaxed">{p.tagline}</p>
            <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
              <a class="link-accent" href={href}>
                Read more &nearr;
              </a>
              <a class="link-accent" href={p.repoUrl}>
                GitHub &nearr;
              </a>
            </p>
          </div>
        </article>
      );
    })
  }
  <p class="muted mt-4 text-sm">{projectsMoreLine}</p>
</section>
