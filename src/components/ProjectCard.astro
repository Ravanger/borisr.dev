---
import { getCollection } from "astro:content";
import ProjectFilter from "../components/ProjectFilter.svelte";
import { projectsMoreLine, sections } from "../data/site";

// The card reads the projects collection itself, so every page that
// renders it (the /projects index and the /design/* reference pages)
// gets the same list with no props to forget.
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const categories = [...new Set(projects.map((entry) => entry.data.category))];

// Silkscreen codes (issue #18): SW-01 / FW-01 / HW-01 — numbered per
// category, in collection order. The status LED beside them is lit for
// LIVE, amber for WIP, unlit for ARCHIVED.
const prefix: Record<string, string> = { Software: "SW", Framework: "FW", Hardware: "HW" };
const perCategoryCount: Record<string, number> = {};
const codeFor = (entry: (typeof projects)[number]) => {
  const category = entry.data.category;
  perCategoryCount[category] = (perCategoryCount[category] ?? 0) + 1;
  return `${prefix[category] ?? "PR"}-${String(perCategoryCount[category]).padStart(2, "0")}`;
};
---

<section id="projects" class="section">
  <p class="eyebrow">{sections.projects.eyebrow}</p>
  <h2 class="section-title">{sections.projects.title}</h2>
  <ProjectFilter client:load categories={categories} />
  <div class="projects-grid">
    {
      projects.map((entry) => {
        const p = entry.data;
        const href = `/projects/${entry.id}`;
        return (
          <article
            class="card project-card"
            data-category={p.category}
          >
            <a href={href} aria-label={p.title} class="project-card-media">
              {
                p.thumbAvif ? (
                  <picture>
                    <source type="image/avif" srcset={p.thumbAvif} />
                    <img
                      src={p.thumb}
                      alt=""
                      loading="lazy"
                      width="1200"
                      height="600"
                      class="project-card-img"
                    />
                  </picture>
                ) : (
                  <img
                    src={p.thumb}
                    alt=""
                    loading="lazy"
                    width="1200"
                    height="600"
                    class="project-card-img"
                  />
                )
              }
            </a>
            <div class="project-card-body">
              <p class="project-silk">
                <span>{codeFor(entry)}</span>
                <span class="project-status">
                  <span
                    class:list={[
                      "status-led",
                      p.status === "LIVE" && "status-led-live",
                      p.status === "WIP" && "status-led-wip",
                      p.status === "ARCHIVED" && "status-led-off",
                    ]}
                    aria-hidden="true"
                  />
                  <span>{p.status}</span>
                </span>
              </p>
              <h3 class="project-card-title">
                <a href={href} class="hover:underline">
                  {p.title}
                </a>
              </h3>
              <p class="muted mt-2 text-sm leading-relaxed">{p.tagline}</p>
              {
                p.imageNote && (
                  <p class="project-img-note">
                    <span aria-hidden="true">&#x25A0; </span>
                    {p.imageNote}
                  </p>
                )
              }
              {
                p.tech.length > 0 && (
                  <ul class="tech-chips" aria-label="Tech used">
                    {p.tech.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )
              }
              <p class="project-card-links">
                <a class="link-accent" href={href}>
                  Read more &nearr;
                </a>
                {
                  p.liveUrl && (
                    <a class="link-accent" href={p.liveUrl}>
                      {p.liveLabel ?? "Open Tool"} &nearr;
                    </a>
                  )
                }
                <a class="link-accent project-gh" href={p.repoUrl} aria-label={`${p.title} on GitHub`} target="_blank" rel="noopener">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                  </svg>
                </a>
              </p>
            </div>
          </article>
        );
      })
    }
  </div>
  <p class="muted mt-4 text-sm">{projectsMoreLine}</p>
</section>
