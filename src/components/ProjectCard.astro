---
import { projects, projectsMoreLine, sections } from "../data/site";
---

<section id="projects" class="section">
  <p class="eyebrow">{sections.projects.eyebrow}</p>
  <h2 class="section-title">{sections.projects.title}</h2>
  {
    projects.map((p) => (
      <article class="card node-row mt-6 p-6">
        <span class="node-disc" aria-hidden="true">&nearr;</span>
        <span class="node-link" aria-hidden="true"></span>
        <div class="node-body">
          <img
            src={p.thumb}
            alt=""
            loading="lazy"
            width="1200"
            height="600"
            class="project-thumb"
          />
          <h3 class="font-display text-xl font-semibold">{p.name}</h3>
          <p class="muted mt-2 text-sm leading-relaxed">{p.tagline}</p>
          <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            {p.liveUrl && (
              <a class="link-accent" href={p.liveUrl}>
                {p.liveLabel} &nearr;
              </a>
            )}
            {p.repoUrl && (
              <a class="link-accent" href={p.repoUrl}>
                {p.repoLabel} &nearr;
              </a>
            )}
          </p>
        </div>
      </article>
    ))
  }
  <p class="muted mt-4 text-sm">{projectsMoreLine}</p>
</section>
