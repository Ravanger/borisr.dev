---
import { email, site, socials } from "../data/site";
import EmailLink from "./EmailLink.astro";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  wrapClass?: string;
}

const { wrapClass = "max-w-6xl" } = Astro.props;
const iconFor: Record<
  string,
  "github" | "instagram" | "tiktok" | "bandcamp" | "soundcloud" | "newgrounds"
> = {
  GitHub: "github",
  Instagram: "instagram",
  TikTok: "tiktok",
  Bandcamp: "bandcamp",
  SoundCloud: "soundcloud",
  Newgrounds: "newgrounds",
};
---

<footer id="contact" class={`mx-auto w-full ${wrapClass} pt-16 pb-10`}>
  <hr class="rule mb-8 border-t" />
  <div class="flex flex-wrap items-baseline justify-between gap-6">
    <p class="text-sm">
      <span class="muted">{site.contactPrefix} </span>
      <EmailLink />
    </p>
    <ul class="footer-socials">
      {
        socials.map((s) => (
          <li>
            <a class="social-link" href={s.href} title={s.label} aria-label={s.label}>
              <SocialIcon name={iconFor[s.label]} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="muted mt-8 text-xs">{site.footerNote}</p>
</footer>

<script define:vars={{ user: email.user, domain: email.domain }}>
  // Assemble the address here so the plain address never appears in the
  // HTML source. (The players above are third-party embeds; see their note.)
  // Class-based: assembles every .email-link on the page.
  (function () {
    var addr = user + "@" + domain;
    var links = document.querySelectorAll(".email-link");
    for (var i = 0; i < links.length; i++) {
      links[i].href = "mailto:" + addr;
      links[i].textContent = addr;
    }
  })();
</script>
