---
/**
 * Fixed top bar (real site): logo left, signal-chain nav centre,
 * footswitch theme toggle right. 64px tall on every viewport; the
 * chain itself shows on desktop only — on mobile the bar is just
 * logo + toggle and the bottom bar carries the nav. The top-left
 * HomeLink is the logo/home link — no duplicated wordmark.
 */
import { siteNav } from "../data/site";
import HomeLink from "./HomeLink.astro";
import ThemeToggle from "./ThemeToggle.svelte";

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="topbar">
  <div class="site-wrap topbar-inner">
    <HomeLink />
    <nav class="topbar-chain" aria-label="Main">
      <span class="chain-end" aria-hidden="true">IN</span>
      <ol class="chain">
        {
          siteNav.map((item) => (
            <li class="chain-item">
              <span class="cable" aria-hidden="true" />
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="chain-link"
              >
                <span class="led" aria-hidden="true" />
                <span class="chain-label">
                  <span>{item.label}</span>
                  <span class="chain-marker" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <span class="cable" aria-hidden="true" />
      <span class="chain-end" aria-hidden="true">OUT</span>
    </nav>
    <ThemeToggle client:load />
  </div>
</header>
