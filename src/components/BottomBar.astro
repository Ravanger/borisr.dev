---
/**
 * Mobile bottom bar (64px + safe-area inset): the four pages with
 * an icon above each label. Desktop has no bottom bar — the top
 * signal chain replaces it. Home is folded into the logo tap.
 * Each link is at least 48x48 (flex-1 item, 48px min height).
 */
import { siteNav } from "../data/site";
import NavIcon from "./NavIcon.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const iconFor: Record<string, "art" | "music" | "projects" | "about"> = {
  "/art": "art",
  "/music": "music",
  "/projects": "projects",
  "/about": "about",
};
---

<div class="bottombar fixed inset-x-0 bottom-0 z-40">
  <nav class="site-wrap" aria-label="Main">
    <ul class="bottombar-list">
      {
        siteNav.map((item) => (
          <li class="flex min-w-0 flex-1">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="bottombar-link"
            >
              <NavIcon name={iconFor[item.href]} />
              <span>{item.label}</span>
              <span class="marker" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
