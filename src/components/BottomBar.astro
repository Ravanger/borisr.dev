---
/**
 * Bottom bar (64px + safe-area inset): the single nav on every
 * viewport — the three pages, with an icon above each label. Home is
 * folded into the logo tap (top-left home link). Each link is at
 * least 48x48 (flex-1 item, 48px min height).
 */
import { siteNav } from "../data/site";
import NavIcon from "./NavIcon.astro";

const pathname = Astro.url.pathname;
// The Routefinder tool page lives under /tools/ but Tools is folded
// into Projects (issue #19), so it counts as a Projects page here.
const isActive = (href: string) =>
  pathname === href ||
  pathname.startsWith(`${href}/`) ||
  (href === "/projects" && pathname.startsWith("/tools/"));
const iconFor: Record<string, "art" | "music" | "projects"> = {
  "/art": "art",
  "/music": "music",
  "/projects": "projects",
};
---

<div class="bottombar fixed inset-x-0 bottom-0 z-40">
  <nav class="site-wrap" aria-label="Main">
    <ul class="bottombar-list">
      {
        siteNav.map((item) => (
          <li class="flex min-w-0 flex-1">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="bottombar-link"
            >
              <span class="marker" aria-hidden="true" />
              <NavIcon name={iconFor[item.href]} />
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
