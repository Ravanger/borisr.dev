---
import { music } from "../data/site";

// SoundCloud uses the classic player (visual=false) with the phosphor
// accent as its colour param: visual=true wastes the height on artwork
// (a real-browser render showed 2 track rows + a clipped third at
// 470px), while the classic player at 470px shows the track list.
// The player sits in an .embed-frame so it never renders as a white
// box while loading. The Bandcamp player moved to the album hero
// (AlbumHero.astro) as the slim player under the tracklist — the large
// Bandcamp embed is gone, not duplicated here.
const soundcloudSrc = `https://w.soundcloud.com/player/?url=${encodeURIComponent(music.soundcloudUrl)}&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=false&color=8cff6a`;
---

<section id="music" class="section">
  <div class="mt-10">
    <figure class="min-w-0">
      <p class="eyebrow mb-3">SoundCloud — Latest tracks</p>
      <div class="embed-frame">
        <iframe
          title="Ravanger on SoundCloud"
          src={soundcloudSrc}
          loading="lazy"
          allow="autoplay"
          class="h-[470px] border-0"></iframe>
      </div>
    </figure>
  </div>
  <div class="mt-12 border-t rule pt-8">
    <p class="text-sm">
      <span class="muted">{music.moreAudioPrefix} </span>
      <a class="link-accent" href={music.newgroundsUrl}>Newgrounds</a>
      <span class="muted"> {music.moreAudioMiddle} </span>
      <a class="link-accent" href={music.bandcampAlbumUrl}>Bandcamp</a>.
    </p>
    <p class="muted mt-3 text-xs">{music.playersNote}</p>
  </div>
</section>
