---
import { music } from "../data/site";

// Bandcamp large player (size=large, 470px) and the SoundCloud classic
// player (visual=false, 470px) sit side by side in a two-column grid on
// desktop, stacking to one column on mobile — the PR #24 arrangement.
// This section is the whole music page: players up top, "More noise"
// links below (the old album hero was removed). Both players sit in
// an .embed-frame so their outer boxes measure the same height — tops
// and bottoms flush, no optical offset. SoundCloud visual=true wastes
// the height on artwork (a real-browser render showed 2 track rows + a
// clipped third at 470px), while the classic player at 470px shows the
// track list. Bandcamp bgcol matches the current theme surface
// (0a0b09), not the pre-theme grey from #24.
const bandcampSrc = `https://bandcamp.com/EmbeddedPlayer/album=${music.bandcampAlbumId}/size=large/bgcol=0a0b09/linkcol=8cff6a/tracklist=true/artwork=small/transparent=true/`;
const soundcloudSrc = `https://w.soundcloud.com/player/?url=${encodeURIComponent(music.soundcloudUrl)}&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=false&color=8cff6a`;
---

<section id="music" class="section">
  <div class="mt-10 grid gap-10 md:grid-cols-[350px_minmax(0,1fr)] md:gap-8">
    <figure class="min-w-0">
      <p class="eyebrow mb-3">Bandcamp — From the Depths</p>
      <div class="embed-frame">
        <iframe
          title="From the Depths by Ravanger on Bandcamp"
          src={bandcampSrc}
          loading="lazy"
          class="h-[470px] w-full max-w-[350px] border-0"></iframe>
      </div>
    </figure>
    <figure class="min-w-0">
      <p class="eyebrow mb-3">SoundCloud — Latest tracks</p>
      <div class="embed-frame">
        <iframe
          title="Ravanger on SoundCloud"
          src={soundcloudSrc}
          loading="lazy"
          allow="autoplay"
          class="h-[470px] border-0"></iframe>
      </div>
    </figure>
  </div>
  <div class="mt-12 border-t rule pt-8">
    <h2 class="section-title">{music.moreNoiseTitle}</h2>
    <div class="more-noise mt-6 flex flex-col gap-6">
      {
        music.moreNoise.map((item) => (
          <a
            class="noise-card card lift"
            href={item.href}
            target="_blank"
            rel="noopener"
          >
            <span class="noise-head">
              <span class="noise-mark" aria-hidden="true">{item.mark}</span>
              <span class="noise-label">{item.label}</span>
              <span class="noise-arrow" aria-hidden="true">↗</span>
            </span>
            <span class="noise-blurb">{item.blurb}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
