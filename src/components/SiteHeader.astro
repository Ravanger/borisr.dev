---
import { nav, site } from "../data/site";
import ThemeToggle from "./ThemeToggle.svelte";

interface Props {
  wrapClass?: string;
}

const { wrapClass = "max-w-6xl" } = Astro.props;
---

<header
  class={`mx-auto flex w-full ${wrapClass} flex-wrap items-baseline justify-between gap-4 px-5 py-6 md:px-8`}
>
  <a href="#top" class="font-display text-lg font-semibold tracking-tight">
    {site.name}
  </a>
  <nav class="flex flex-wrap items-center gap-x-5 gap-y-2" aria-label="Main">
    {
      nav.map((item) => (
        <a href={item.href} class="muted text-sm hover:underline">
          {item.label}
        </a>
      ))
    }
    <ThemeToggle client:load />
  </nav>
</header>
