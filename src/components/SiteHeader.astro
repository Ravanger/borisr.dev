---
import { nav, site } from "../data/site";

interface Props {
  wrapClass?: string;
}

const { wrapClass = "max-w-6xl" } = Astro.props;
---

<header
  class={`mx-auto flex w-full ${wrapClass} flex-wrap items-baseline justify-between gap-4 py-6 pl-5 pr-16 md:pl-8 md:pr-20`}
>
  <a href="/" class="font-display text-lg font-semibold tracking-tight hover:underline">
    {site.name}
  </a>
  <nav class="flex flex-wrap items-center gap-x-5 gap-y-2" aria-label="Main">
    {
      nav.map((item) => (
        <a href={item.href} class="muted text-sm hover:underline">
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
