---
import AvatarCard from "../components/AvatarCard.astro";
import EmailLink from "../components/EmailLink.astro";
import { about, sections, site, socials } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="About — borisr.dev" description={site.description}>
  <div class="page-top">
    <div class="about-grid">
      <div class="about-side">
        <AvatarCard />
      </div>
      <div class="about-body">
        <p class="eyebrow">{sections.about.eyebrow}</p>
        <h1 class="section-title">{sections.about.title}</h1>
        {
          about.paragraphs.map((p) => (
            <p class="about-copy">{p}</p>
          ))
        }
        <section class="rig" aria-label="The rig">
          <h2 class="eyebrow">The rig</h2>
          {
            about.rig.map((group) => (
              <div class="rig-group">
                <p class="rig-label">{group.label}</p>
                <p class="rig-items">
                  {group.items.map((item, i) => (
                    <>
                      {i > 0 && <span class="muted"> · </span>}
                      <span>{item.name}</span>
                      {item.note && <span class="muted"> ({item.note})</span>}
                    </>
                  ))}
                </p>
              </div>
            ))
          }
        </section>
        <hr class="rule mt-10 border-t" />
        <p class="mt-6 text-sm">
          <span class="muted">{site.contactPrefix} </span>
          <EmailLink />
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
          {
            socials.map((s) => (
              <li>
                <a class="muted text-sm hover:underline" href={s.href}>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</SiteLayout>
