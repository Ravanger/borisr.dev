---
import EmailLink from "../components/EmailLink.astro";
import { contact, sections, site, socials } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Contact — borisr.dev" description={site.description}>
  <div class="page-top">
    <section class="section">
      <p class="eyebrow">{sections.contact.eyebrow}</p>
      <h1 class="section-title">{sections.contact.title}</h1>
      <p class="muted mt-3 max-w-xl text-sm leading-relaxed">{contact.intro}</p>
      <p class="mt-6 text-lg"><EmailLink /></p>
      <p class="eyebrow mt-12">{contact.socialsHeading}</p>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        {
          socials.map((s) => (
            <li>
              <a class="link-accent text-sm" href={s.href}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</SiteLayout>
