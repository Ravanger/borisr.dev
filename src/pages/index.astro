---
import TeaserMotif from "../components/TeaserMotif.astro";
import { site, teasers } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Boris Rossovsky — borisr.dev" description={site.description}>
  <div class="grid gap-8 pt-16 md:grid-cols-12 md:pt-20">
    <div class="md:col-span-5">
      <p class="eyebrow">{site.domain}</p>
      <h1
        class="font-display mt-4 text-5xl leading-[1.02] font-medium tracking-tight md:text-6xl"
      >
        Boris<br />Rossovsky
      </h1>
    </div>
    <p class="muted max-w-md leading-relaxed md:col-span-7 md:self-end">{site.intro}</p>
  </div>
  <div class="mt-14 grid gap-4 sm:grid-cols-2">
    {
      teasers.map((t) => (
        <a href={t.href} class="card lift block p-6">
          <div class="teaser-head">
            <p class="eyebrow">
              {t.index} / {t.label}
            </p>
            <TeaserMotif motif={t.motif} />
          </div>
          <p class="muted mt-3 text-sm leading-relaxed">{t.description}</p>
          <p class="mt-4 text-sm">
            <span class="link-accent">Open &nearr;</span>
          </p>
        </a>
      ))
    }
  </div>
</SiteLayout>
