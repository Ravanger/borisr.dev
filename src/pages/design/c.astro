---
import ArtFeed from "../../components/ArtFeed.astro";
import MusicEmbeds from "../../components/MusicEmbeds.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ToolsCard from "../../components/ToolsCard.astro";
import { site } from "../../data/site";
import DesignLayout from "../../layouts/DesignLayout.astro";

const fonts = [
  "https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600&f[]=satoshi@400,500,700&display=swap",
  "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap",
];
const wrap = "max-w-4xl";
---

<DesignLayout
  theme="c"
  title="Boris Rossovsky — borisr.dev (Direction C)"
  description={site.description}
  fonts={fonts}
  wrapClass={wrap}
>
  <div class={`mx-auto w-full ${wrap} px-6`}>
    <div class="grid gap-8 pt-12 md:grid-cols-12 md:pt-20">
      <div class="md:col-span-5">
        <p class="eyebrow">{site.domain}</p>
        <h1
          class="font-display mt-4 text-5xl leading-[1.02] font-medium tracking-tight md:text-6xl"
        >
          Boris<br />Rossovsky
        </h1>
      </div>
      <p class="muted max-w-md leading-relaxed md:col-span-7 md:self-end">{site.intro}</p>
    </div>
    <ArtFeed />
    <MusicEmbeds />
    <ProjectCard />
    <ToolsCard />
  </div>
</DesignLayout>
