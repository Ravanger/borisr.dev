---
import { ClientRouter } from "astro:transitions";
import "../styles/tokens.css";
import BottomBar from "../components/BottomBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeInit from "../components/ThemeInit.astro";
import TopBar from "../components/TopBar.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="theme-c">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Self-hosted fonts (public/fonts/): preload the display face;
         the other two load via @font-face in tokens.css. No remote
         font requests on the real site. -->
    <link
      rel="preload"
      href="/fonts/big-shoulders-display-latin-800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />
    <ThemeInit />
  </head>
  <body id="top">
    <!-- Grain overlay: the only full-page texture (see .grain in
         tokens.css). Real site only — the /design pages don't get it. -->
    <div class="grain" aria-hidden="true"></div>
    <TopBar />
    <main class="site-wrap">
      <slot />
    </main>
    <SiteFooter wrapClass="site-wrap" />
    <BottomBar />
  </body>
</html>
